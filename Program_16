import cv2
import numpy as np
from google.colab.patches import cv2_imshow # Import cv2_imshow for Colab
from google.colab import files # Import files for uploading

print("Please upload your image when prompted.")
uploaded = files.upload()

image_filename = next(iter(uploaded))

img = cv2.imread(image_filename)

if img is None:
    print(f"Error: Could not read the image '{image_filename}'. Please make sure it was uploaded correctly.")
else:
    kernel = np.ones((5,5), np.uint8)

    dilation = cv2.dilate(img, kernel, iterations=1)

    print("Original Image")
    cv2_imshow(img)
    print("Dilation Image")
    cv2_imshow(dilation)
