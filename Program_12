import cv2
from google.colab.patches import cv2_imshow # Import cv2_imshow
from google.colab import files # Import files for uploading
import numpy as np # Import numpy for normalization

print("Please upload your image when prompted.")
uploaded = files.upload()
image_filename = next(iter(uploaded))
img = cv2.imread(image_filename, 0)
if img is None:
    print(f'Error: Could not read the image {image_filename}. Please ensure the file was uploaded correctly.')
else:
    # Apply Sobel filter
    sobel = cv2.Sobel(img, cv2.CV_64F, 1, 1, ksize=5)
    sobel_display = cv2.normalize(sobel, None, 0, 255, cv2.NORM_MINMAX, cv2.CV_8U)
    print("Original Image")
    cv2_imshow(img)
    print("Sobel Image")
    cv2_imshow(sobel_display)
