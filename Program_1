import cv2
from google.colab.patches import cv2_imshow
from google.colab import files

print("Please upload your image when prompted.")
uploaded = files.upload()

# Assuming the uploaded file is 'Goutham.jpg' as per the conversation context.
# If you upload a different file, please change 'Goutham.jpg' to your file name.
image_filename = next(iter(uploaded))
img = cv2.imread(image_filename)

# Check if image is loaded properly
if img is None:
    print(f"Error: Could not read the image '{image_filename}'. Please make sure it was uploaded correctly.")
else:
    # Convert to grayscale
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # Show images
    print("Original Image")
    cv2_imshow(img)

    print("Gray Scale Image")
    cv2_imshow(gray)

    # Save the grayscale image
    cv2.imwrite('gray_image.jpg', gray)
